# Copy to .env and fill in values for the machine running Master and Worker.
REDIS_URL="redis://127.0.0.1:6379/0"

# Volcengine ECS: the image name for the walkthrough task must be FEniCS.
VOLCENGINE_ACCESS_KEY_ID="YOUR_ACCESS_KEY_ID"
VOLCENGINE_SECRET_ACCESS_KEY="YOUR_SECRET_ACCESS_KEY"
VOLCENGINE_REGION="YOUR_REGION"
VOLCENGINE_ZONE_ID="YOUR_ZONE_ID"
VOLCENGINE_SUBNET_ID="YOUR_SUBNET_ID"
VOLCENGINE_SECURITY_GROUP_ID="YOUR_SECURITY_GROUP_ID"
VOLCENGINE_INSTANCE_TYPE="YOUR_INSTANCE_TYPE"

# TOS S3-compatible endpoint and task result bucket.
VOLCENGINE_S3_ENDPOINT_URL="https://YOUR_TOS_S3_ENDPOINT"
VOLCENGINE_S3_BUCKET="YOUR_RESULTS_BUCKET"

# OSWorld VM-server archive and its <archive>.manifest.json in this bucket.
VM_OSWORLD_BUNDLE_BUCKET="YOUR_VM_SERVER_BUCKET"
VM_OSWORLD_BUNDLE_PATH="releases/YOUR_VM_SERVER_BUNDLE.tgz"

# OpenAI-compatible model gateway used by the single-task walkthrough.
OPENAI_BASE_URL="https://YOUR_MODEL_GATEWAY/v1"
OPENAI_API_KEY="YOUR_MODEL_API_KEY"
