/BATCH
/FILNAME,Job-Cylinder,1
/TITLE,EngiWorld CLI task-02 axisymmetric thick-walled cylinder
/PREP7
ET,1,PLANE182
KEYOPT,1,1,0
KEYOPT,1,3,1
MP,EX,1,210000
MP,PRXY,1,0.3

! 33 nodes on an exact 5 mm structured grid: X=radial, Y=axial.
*DO,jj,0,2
*DO,ii,0,10
node_id=1+jj*11+ii
N,node_id,50+ii*5,jj*5,0
*ENDDO
*ENDDO

TYPE,1
MAT,1
*DO,jj,0,1
*DO,ii,0,9
n1=1+jj*11+ii
n2=n1+1
n4=n1+11
n3=n4+1
E,n1,n2,n3,n4
*ENDDO
*ENDDO

ALLSEL,ALL
CM,ALLNODES,NODE
NSEL,S,LOC,X,50
CM,INNER,NODE
NSEL,S,LOC,X,100
CM,OUTER,NODE
NSEL,S,LOC,Y,0
CM,ZMIN,NODE
NSEL,S,LOC,Y,10
CM,ZMAX,NODE
ALLSEL,ALL

D,ALLNODES,UY,0

pressure=10
inner_radius=50
pi=ACOS(-1)
force_end=pressure*2*pi*inner_radius*2.5
force_middle=pressure*2*pi*inner_radius*5
F,1,FX,force_end
F,12,FX,force_middle
F,23,FX,force_end
total_fx=2*force_end+force_middle
expected_fx=pressure*2*pi*inner_radius*10

FINISH
/SOLU
ANTYPE,STATIC
OUTRES,ALL,ALL
SOLVE
FINISH
SAVE,Job-Cylinder,db

/POST1
FILE,Job-Cylinder,rst
SET,LAST
*GET,radial_displacement,NODE,12,U,X
NSORT,S,EQV,0,1,ALL
*GET,max_mises,SORT,0,MAX
ALLSEL,ALL

*CFOPEN,metrics,json
*VWRITE,radial_displacement
('{"radial_displacement": ',E24.16,',')
*VWRITE,max_mises
(' "max_mises": ',E24.16,'}')
*CFCLOS

*CFOPEN,native_audit,txt
*VWRITE
('software=ANSYS Mechanical APDL 2026 R1')
*VWRITE
('release=26.1')
*VWRITE
('analysis=2D axisymmetric static structural plane-strain kinematics')
*VWRITE
('job_name=Job-Cylinder')
*VWRITE
('element_type=PLANE182')
*VWRITE
('keyopt_1_full_integration=0')
*VWRITE
('keyopt_3_axisymmetric=1')
*VWRITE
('nodes=33')
*VWRITE
('elements=20')
*VWRITE
('structured_mesh_size_mm=5')
*VWRITE
('sets=ALLNODES,INNER,OUTER,ZMIN,ZMAX')
*VWRITE
('boundary_condition=ALLNODES UY=0; no UX constraint')
*VWRITE,force_end
('inner_end_fx_n=',E24.16)
*VWRITE,force_middle
('inner_middle_fx_n=',E24.16)
*VWRITE,total_fx
('total_fx_n=',E24.16)
*VWRITE,expected_fx
('expected_total_fx_n=',E24.16)
*VWRITE,radial_displacement
('radial_displacement_mm=',E24.16)
*VWRITE,max_mises
('max_mises_mpa=',E24.16)
*CFCLOS
FINISH
SAVE,Job-Cylinder,db
/EXIT,NOSAVE
