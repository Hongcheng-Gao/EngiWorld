/BATCH
/FILNAME,Job-Plate,1
/TITLE,EngiWorld CLI task-01 axisymmetric circular plate
/PREP7
ET,1,PLANE183
KEYOPT,1,3,1
MP,EX,1,210000
MP,PRXY,1,0.3

! Corner nodes on the lower and upper faces.
*DO,ii,0,25
N,1+ii,2*ii,0,0
N,27+ii,2*ii,1,0
*ENDDO

! Horizontal midside nodes on the lower and upper faces.
*DO,ii,0,24
N,53+ii,2*ii+1,0,0
N,78+ii,2*ii+1,1,0
*ENDDO

! Vertical midside nodes shared by adjacent elements.
*DO,ii,0,25
N,103+ii,2*ii,0.5,0
*ENDDO

! One PLANE183 element through the thickness and 25 radially.
TYPE,1
MAT,1
*DO,ii,0,24
E,1+ii,2+ii,28+ii,27+ii,53+ii,104+ii,78+ii,103+ii
*ENDDO

NSEL,S,LOC,X,0
CM,AXIS,NODE
NSEL,S,LOC,X,50
CM,OUTER,NODE
NSEL,S,LOC,Y,1
CM,TOP,NODE
ALLSEL,ALL

D,AXIS,UX,0
D,OUTER,UX,0
D,OUTER,UY,0

press=0.1
pi=ACOS(-1)
total_fy=0
*DO,ii,0,50
radius=ii
*IF,MOD(ii,2),EQ,0,THEN
top_node=27+ii/2
*ELSE
top_node=78+(ii-1)/2
*ENDIF
delta_r=1
*IF,ii,EQ,0,THEN
delta_r=0.5
*ENDIF
*IF,ii,EQ,50,THEN
delta_r=0.5
*ENDIF
node_fy=-press*2*pi*radius*delta_r
total_fy=total_fy+node_fy
*IF,ABS(node_fy),GT,0,THEN
F,top_node,FY,node_fy
*ENDIF
*ENDDO

FINISH
/SOLU
ANTYPE,STATIC
OUTRES,ALL,ALL
SOLVE
FINISH
SAVE,Job-Plate,db

/POST1
FILE,Job-Plate,rst
SET,LAST
*GET,center_u2,NODE,27,U,Y
NSORT,S,EQV,0,1,ALL
*GET,max_mises,SORT,0,MAX
ALLSEL,ALL
NSEL,S,LOC,X,50
*GET,rf26,NODE,26,RF,FY
*GET,rf52,NODE,52,RF,FY
*GET,rf128,NODE,128,RF,FY
support_fy=rf26+rf52+rf128
ALLSEL,ALL
expected_fy=-press*pi*50*50

*CFOPEN,metrics,json
*VWRITE,center_u2
('{"center_deflection": ',E24.16,',')
*VWRITE,max_mises
(' "max_mises": ',E24.16,'}')
*CFCLOS

*CFOPEN,cli_task01_ansys_audit,txt
*VWRITE
('software=ANSYS Mechanical APDL 2026 R1')
*VWRITE
('analysis=2D axisymmetric static structural')
*VWRITE
('element_type=PLANE183')
*VWRITE
('axisymmetric_keyopt_3=1')
*VWRITE
('nodes=128')
*VWRITE
('elements=25')
*VWRITE
('top_nodes=51')
*VWRITE,total_fy
('total_fy_n=',E24.16)
*VWRITE,expected_fy
('expected_total_fy_n=',E24.16)
*VWRITE,support_fy
('support_fy_n=',E24.16)
*VWRITE,center_u2
('center_deflection_mm=',E24.16)
*VWRITE,max_mises
('max_mises_mpa=',E24.16)
*CFCLOS
FINISH
SAVE,Job-Plate,db
/EXIT,NOSAVE
