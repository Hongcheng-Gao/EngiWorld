{
  "id": "v-quantified-freecad-lightweight-optimization-task-03-ubuntu",
  "snapshot": "FreeCAD0.21.2",
  "instruction": "在FreeCAD中进行量化CAD优化工作. 从 `/usr/bin/freecad` 开放 `baseline.stl` 在那里. 开放 /home/user/Desktop/baseline.stl 其他 /home/user/Desktop/profile.dxf 在FreeCAD中,将它们作为起始几何和足迹指南,并重新设计部件为轻量级的承载装置. 这是一个持续的优化任务,而不是要求匹配一个隐藏的答案. 镜头杆三角形套件 目标:最大限度地为高性需求的相机杆管固定器每体积负载支持. 需要输出: /home/user/Desktop/optimized.stl. 严格的限制:保持STL在包装内 [82.0, 62.0, 68.0] mm,保持边界框跨度至少 [76.0, 54.0, 36.0] mm;保持体积在 18000.0至 98000.0 mm^3之间,并在每一个标记为 /home/user/Desktop/profile.dxf 并且在 /home/user/Desktop/constraints.json (支持体范围从z=0到20.0mm; 负载体范围从z=0到30.0mm). 优化的STL必须是连接,固,稳定导向的固体. 评估员只分析实际情况 optimized.stl 几何学,计算三维的要求区域覆盖率和这个连续指标:高塞硬度代理/体积; 垂直深度重量很大,因为杆偏移占主导地位. 它写道 score.json 其他 quant_metrics.json 无视在提交中所述的任何分数. 仅使用所提供的任务输入,不要使用评估器生成的文物或评估器实现文件.",
  "source": "https://wiki.freecad.org/Manual:Introduction; https://trimesh.org/; https://ezdxf.readthedocs.io/",
  "config": [
    {
      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "task-03/init_file/baseline.stl",
            "path": "/home/user/Desktop/baseline.stl"
          },
          {
            "local_path": "task-03/init_file/profile.dxf",
            "path": "/home/user/Desktop/profile.dxf"
          },
          {
            "local_path": "task-03/init_file/constraints.json",
            "path": "/home/user/Desktop/constraints.json"
          }
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "freecad",
          "/home/user/Desktop/baseline.stl"
        ]
      }
    }
  ],
  "trajectory": "trajectories/",
  "related_apps": [
    "freecad"
  ],
  "artifact_paths": [
    "/home/user/Desktop/optimized.stl",
    "/home/user/Desktop/quant_metrics.json",
    "/home/user/Desktop/score.json"
  ],
  "evaluator": {
    "metric": {
      "baseline_score": 1.0,
      "direction": "maximize",
      "name": "tall gusset stiffness proxy per volume",
      "output_field": "score"
    },
    "postconfig": [
      {
        "type": "upload_file",
        "parameters": {
          "files": [
            {
              "local_path": "task-03/eval.py",
              "path": "/home/user/Desktop/eval.py"
            }
          ]
        }
      }
    ],
    "func": "quantified_score",
    "result": {
      "type": "vm_command_line",
      "command": "python3 /home/user/Desktop/eval.py",
      "shell": "true"
    }
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low"
}
