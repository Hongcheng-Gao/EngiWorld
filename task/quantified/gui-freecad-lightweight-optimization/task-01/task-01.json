{
  "id": "v-quantified-freecad-lightweight-optimization-task-01-ubuntu",
  "snapshot": "FreeCAD0.21.2",
  "instruction": "完成用FreeCAD进行量化CAD优化. 从 FreeCAD 启动 `/usr/bin/freecad` 开放 `baseline.stl` 在那里. 开放 /home/user/Desktop/baseline.stl 其他 /home/user/Desktop/profile.dxf 在FreeCAD中,将它们作为起始几何和足迹指南,并重新设计部件为轻量级的承载装置. 这是一个持续的优化任务,而不是要求匹配一个隐藏的答案. 传感器杆可靠架支架 目标:最大化传感器杆架支架的负载容量代理. 需要输出: /home/user/Desktop/optimized.stl. 严格的限制:保持STL在包装范围内 [100.0, 42.0, 34.0] mm,保持界限框跨度至少 [94.0, 36.0, 18.0] mm;保持体积在 12000.0 和 62000.0 mm^3之间,并保留每一个标记为 /home/user/Desktop/profile.dxf 并且在 /home/user/Desktop/constraints.json (支持体范围从z=0到12.0mm; 负载体范围从z=0到16.0mm). 优化的STL必须是连接,固,稳定导向的固体. 评估员只分析实际情况 optimized.stl 几何学,计算三维要求区域覆盖率和这个连续的指标:杆负载代理/体积; 长距离支架高度,足迹距离和所需的支持/负载区材料提高了分数. 它写道 score.json 其他 quant_metrics.json 无视在提交中所述的任何分数. 仅使用所提供的任务输入,不要使用评估器生成的文物或评估器实现文件.",
  "source": "https://wiki.freecad.org/Manual:Introduction; https://trimesh.org/; https://ezdxf.readthedocs.io/",
  "config": [
    {
      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "task-01/init_file/baseline.stl",
            "path": "/home/user/Desktop/baseline.stl"
          },
          {
            "local_path": "task-01/init_file/profile.dxf",
            "path": "/home/user/Desktop/profile.dxf"
          },
          {
            "local_path": "task-01/init_file/constraints.json",
            "path": "/home/user/Desktop/constraints.json"
          }
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "freecad",
          "/home/user/Desktop/baseline.stl"
        ]
      }
    }
  ],
  "trajectory": "trajectories/",
  "related_apps": [
    "freecad"
  ],
  "artifact_paths": [
    "/home/user/Desktop/optimized.stl",
    "/home/user/Desktop/quant_metrics.json",
    "/home/user/Desktop/score.json"
  ],
  "evaluator": {
    "metric": {
      "baseline_score": 1.0,
      "direction": "maximize",
      "name": "cantilever load proxy per volume",
      "output_field": "score"
    },
    "postconfig": [
      {
        "type": "upload_file",
        "parameters": {
          "files": [
            {
              "local_path": "task-01/eval.py",
              "path": "/home/user/Desktop/eval.py"
            }
          ]
        }
      }
    ],
    "func": "quantified_score",
    "result": {
      "type": "vm_command_line",
      "command": "python3 /home/user/Desktop/eval.py",
      "shell": "true"
    }
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low"
}
