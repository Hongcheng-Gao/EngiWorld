{
  "id": "opt-ansys-gui-02",
  "title": "ANSYS GUI buckling factor per mass optimization",
  "interface": "gui",
  "primary_software": "ansys",
  "objective": "Maximize first buckling factor per unit mass.",
  "fixed_features": [
    "column length",
    "pin-style end constraints",
    "axial compressive load",
    "linear eigenvalue buckling analysis type"
  ],
  "constraints": {
    "fixed_length_mm": 1000.0,
    "reference_compressive_load_n": 1.0,
    "material_E_mpa": 210000.0,
    "material_nu": 0.3
  },
  "baseline": {
    "files": [
      "baseline_wb_buckling.wbpj",
      "baseline_wb_buckling.db",
      "baseline_wb_buckling.rst"
    ]
  },
  "submission": {
    "files": [
      "submission.db",
      "submission.rst"
    ]
  },
  "workflow": {
    "must_use": "interactive graphical interface"
  }
}
