{
  "id": "opt-ansys-gui-01",
  "title": "ANSYS GUI load-bearing structure mass optimization",
  "interface": "gui",
  "primary_software": "ansys",
  "objective": "Minimize structural mass while satisfying displacement and stress limits.",
  "fixed_features": [
    "fixed support region",
    "loaded region",
    "mounting and loading interfaces",
    "outer envelope"
  ],
  "constraints": {
    "unit_system": "N-mm",
    "max_displacement": 0.8,
    "allowable_mises": 160.0,
    "envelope_mm": [
      100.0,
      50.0,
      5.0
    ],
    "material_E_mpa": 210000.0,
    "material_nu": 0.3
  },
  "baseline": {
    "files": [
      "baseline_apdl_hole_plate.db",
      "baseline_apdl_hole_plate.rst"
    ]
  },
  "submission": {
    "files": [
      "submission.db",
      "submission.rst"
    ]
  },
  "workflow": {
    "must_use": "interactive graphical interface"
  }
}
