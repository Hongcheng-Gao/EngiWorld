{
  "id": "opt-ansys-gui-03",
  "title": "ANSYS GUI first-frequency per mass optimization",
  "interface": "gui",
  "primary_software": "ansys",
  "objective": "Maximize first natural frequency per unit mass.",
  "fixed_features": [
    "end attachment regions",
    "fixed boundary conditions",
    "modal analysis type",
    "500 mm beam envelope"
  ],
  "constraints": {
    "fixed_length_mm": 500.0,
    "material_E_mpa": 210000.0,
    "material_nu": 0.3,
    "density_tonne_per_mm3": 7.85e-09
  },
  "baseline": {
    "files": [
      "baseline_apdl_fixed_beam_modal.db",
      "baseline_apdl_fixed_beam_modal.rst"
    ]
  },
  "submission": {
    "files": [
      "submission.db",
      "submission.rst"
    ]
  },
  "workflow": {
    "must_use": "interactive graphical interface"
  }
}
