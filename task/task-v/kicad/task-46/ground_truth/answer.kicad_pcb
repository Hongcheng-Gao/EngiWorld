(kicad_pcb
  (version 20240108)
  (generator "pcbnew")
  (generator_version "9.0")
  (general
    (thickness 1.6)
    (legacy_teardrops no)
  )
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (44 "Edge.Cuts" user)
  )
  (setup
    (pad_to_mask_clearance 0.1)
    (allow_soldermask_bridges_in_footprints no)
  )
  (net 0 "")
  (net 1 "VCC")
  (net 2 "GND")

  ; HAT+ board outline: 65x56.5mm with R=3mm rounded corners
  ; Straight edges
  (gr_line (start 3 0) (end 62 0) (layer "Edge.Cuts") (width 0.1))
  (gr_line (start 65 3) (end 65 53.5) (layer "Edge.Cuts") (width 0.1))
  (gr_line (start 62 56.5) (end 3 56.5) (layer "Edge.Cuts") (width 0.1))
  (gr_line (start 0 53.5) (end 0 3) (layer "Edge.Cuts") (width 0.1))

  ; Rounded corners (gr_arc: start, mid, end)
  ; Bottom-left corner: center(3,3), R=3, arc from (0,3) through (0.879,0.879) to (3,0)
  (gr_arc (start 0 3) (mid 0.879 0.879) (end 3 0) (layer "Edge.Cuts") (width 0.1))
  ; Bottom-right corner: center(62,3), R=3, arc from (62,0) through (64.121,0.879) to (65,3)
  (gr_arc (start 62 0) (mid 64.121 0.879) (end 65 3) (layer "Edge.Cuts") (width 0.1))
  ; Top-right corner: center(62,53.5), R=3, arc from (65,53.5) through (64.121,55.621) to (62,56.5)
  (gr_arc (start 65 53.5) (mid 64.121 55.621) (end 62 56.5) (layer "Edge.Cuts") (width 0.1))
  ; Top-left corner: center(3,53.5), R=3, arc from (3,56.5) through (0.879,55.621) to (0,53.5)
  (gr_arc (start 3 56.5) (mid 0.879 55.621) (end 0 53.5) (layer "Edge.Cuts") (width 0.1))

  ; 4 M2.5 mounting holes at HAT+ spec positions
  (footprint "MountingHole:MountingHole_2.75mm_M2.5" (layer "F.Cu") (at 3.5 3.5)
    (reference "H1") (value "MountingHole")
    (pad "" np_thru_hole circle (at 0 0) (size 2.75 2.75) (drill 2.75)
      (layers "F.Cu" "B.Cu" "F.Mask" "B.Mask"))
  )

  (footprint "MountingHole:MountingHole_2.75mm_M2.5" (layer "F.Cu") (at 61.5 3.5)
    (reference "H2") (value "MountingHole")
    (pad "" np_thru_hole circle (at 0 0) (size 2.75 2.75) (drill 2.75)
      (layers "F.Cu" "B.Cu" "F.Mask" "B.Mask"))
  )

  (footprint "MountingHole:MountingHole_2.75mm_M2.5" (layer "F.Cu") (at 3.5 53)
    (reference "H3") (value "MountingHole")
    (pad "" np_thru_hole circle (at 0 0) (size 2.75 2.75) (drill 2.75)
      (layers "F.Cu" "B.Cu" "F.Mask" "B.Mask"))
  )

  (footprint "MountingHole:MountingHole_2.75mm_M2.5" (layer "F.Cu") (at 61.5 53)
    (reference "H4") (value "MountingHole")
    (pad "" np_thru_hole circle (at 0 0) (size 2.75 2.75) (drill 2.75)
      (layers "F.Cu" "B.Cu" "F.Mask" "B.Mask"))
  )

  ; 2x20 GPIO header repositioned to HAT+ spec position (29.0, 52.5)
  (footprint "Connector_PinHeader_2.54mm:PinHeader_2x20_P2.54mm_Vertical" (layer "F.Cu") (at 29.0 52.5)
    (reference "J1") (value "GPIO_HEADER")
    (pad "1" thru_hole circle (at 0 0) (size 1.7 1.7) (drill 1.0)
      (layers "F.Cu" "B.Cu" "F.Mask" "B.Mask") (net 1 "VCC"))
  )
)
