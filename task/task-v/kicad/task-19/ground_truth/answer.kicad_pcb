(kicad_pcb
  (version 20240108)
  (generator "pcbnew")
  (generator_version "9.0")
  (general
    (thickness 1.6)
    (legacy_teardrops no)
  )
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (44 "Edge.Cuts" user)
  )
  (setup
    (pad_to_mask_clearance 0.1)
    (allow_soldermask_bridges_in_footprints no)
  )
  (net 0 "")
  (net 1 "CLK")
  (net 2 "GND")
  (net 3 "VCC")
  (net 4 "CLK_PRE")

  ; Source IC: U1 at (10, 30) — output pad drives CLK_PRE
  (footprint "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm" (layer "F.Cu") (at 10 30)
    (reference "U1") (value "74HC04")
    (pad "3" thru_hole circle (at 0 0) (size 1.4 1.4) (drill 0.8)
      (layers "F.Cu" "B.Cu" "F.Mask" "B.Mask") (net 4 "CLK_PRE"))
  )

  ; Load 1: U2 at (50, 15) — CLK net
  (footprint "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm" (layer "F.Cu") (at 50 15)
    (reference "U2") (value "74HCT74")
    (pad "1" thru_hole circle (at 0 0) (size 1.4 1.4) (drill 0.8)
      (layers "F.Cu" "B.Cu" "F.Mask" "B.Mask") (net 1 "CLK"))
  )

  ; Load 2: U3 at (50, 30) — CLK net
  (footprint "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm" (layer "F.Cu") (at 50 30)
    (reference "U3") (value "74HCT74")
    (pad "1" thru_hole circle (at 0 0) (size 1.4 1.4) (drill 0.8)
      (layers "F.Cu" "B.Cu" "F.Mask" "B.Mask") (net 1 "CLK"))
  )

  ; Load 3: U4 at (50, 45) — CLK net
  (footprint "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm" (layer "F.Cu") (at 50 45)
    (reference "U4") (value "74HCT74")
    (pad "1" thru_hole circle (at 0 0) (size 1.4 1.4) (drill 0.8)
      (layers "F.Cu" "B.Cu" "F.Mask" "B.Mask") (net 1 "CLK"))
  )

  ; R_TERM moved to (20, 30), between source and loads — pad1 on CLK_PRE, pad2 on CLK
  (footprint "Resistor_SMD:R_0603_1608Metric" (layer "F.Cu") (at 20 30)
    (reference "R_TERM") (value "22R")
    (pad "1" smd rect (at -0.8 0) (size 1.0 0.8)
      (layers "F.Cu" "F.Paste" "F.Mask") (net 4 "CLK_PRE"))
    (pad "2" smd rect (at 0.8 0) (size 1.0 0.8)
      (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "CLK"))
  )

  ; CLK_PRE: U1(10,30) -> R_TERM.pad1(19.2,30): length=9.2mm
  (segment (start 10 30) (end 19.2 30) (width 0.2) (layer "F.Cu") (net 4))

  ; CLK daisy chain: R_TERM.pad2(20.8,30) -> U2(50,15) -> U3(50,30) -> U4(50,45)
  ; Segment 1: (20.8,30) -> (50,15): length=sqrt((50-20.8)^2+(15-30)^2)=sqrt(29.2^2+15^2)=sqrt(852.64+225)=sqrt(1077.64)=32.83mm
  (segment (start 20.8 30) (end 50 15) (width 0.2) (layer "F.Cu") (net 1))
  ; Segment 2: U2(50,15) -> U3(50,30): length=15mm
  (segment (start 50 15) (end 50 30) (width 0.2) (layer "F.Cu") (net 1))
  ; Segment 3: U3(50,30) -> U4(50,45): length=15mm
  (segment (start 50 30) (end 50 45) (width 0.2) (layer "F.Cu") (net 1))

  ; Total CLK length: 32.83+15+15=62.83mm <= 100mm (ok)
  ; CLK_PRE length: 9.2mm
  ; Chain: each load directly on the trunk (no stubs), so max stub=0 <= 5mm

  (gr_rect (start 0 0) (end 100 80) (layer "Edge.Cuts") (width 0.1))
)
