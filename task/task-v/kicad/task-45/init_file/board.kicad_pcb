(kicad_pcb
  (version 20240108)
  (generator "pcbnew")
  (generator_version "9.0")
  (general
    (thickness 1.6)
    (legacy_teardrops no)
  )
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (44 "Edge.Cuts" user)
  )
  (setup
    (pad_to_mask_clearance 0.1)
    (allow_soldermask_bridges_in_footprints no)
  )
  (net 0 "")
  (net 1 "CLK")
  (net 2 "GND")
  (net 3 "VCC")

  ; Source IC: U1 at (10, 30) — output pad drives CLK
  (footprint "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm" (layer "F.Cu") (at 10 30)
    (reference "U1") (value "74HC04")
    (pad "3" thru_hole circle (at 0 0) (size 1.4 1.4) (drill 0.8)
      (layers "F.Cu" "B.Cu" "F.Mask" "B.Mask") (net 1 "CLK"))
  )

  ; Load 1: U2 at (50, 15)
  (footprint "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm" (layer "F.Cu") (at 50 15)
    (reference "U2") (value "74HCT74")
    (pad "1" thru_hole circle (at 0 0) (size 1.4 1.4) (drill 0.8)
      (layers "F.Cu" "B.Cu" "F.Mask" "B.Mask") (net 1 "CLK"))
  )

  ; Load 2: U3 at (50, 30)
  (footprint "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm" (layer "F.Cu") (at 50 30)
    (reference "U3") (value "74HCT74")
    (pad "1" thru_hole circle (at 0 0) (size 1.4 1.4) (drill 0.8)
      (layers "F.Cu" "B.Cu" "F.Mask" "B.Mask") (net 1 "CLK"))
  )

  ; Load 3: U4 at (50, 45)
  (footprint "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm" (layer "F.Cu") (at 50 45)
    (reference "U4") (value "74HCT74")
    (pad "1" thru_hole circle (at 0 0) (size 1.4 1.4) (drill 0.8)
      (layers "F.Cu" "B.Cu" "F.Mask" "B.Mask") (net 1 "CLK"))
  )

  ; Series termination resistor placeholder (scratch area, not connected)
  (footprint "Resistor_SMD:R_0603_1608Metric" (layer "F.Cu") (at 80 30)
    (reference "R_TERM") (value "22R")
    (pad "1" smd rect (at -0.8 0) (size 1.0 0.8)
      (layers "F.Cu" "F.Paste" "F.Mask") (net 0 ""))
    (pad "2" smd rect (at 0.8 0) (size 1.0 0.8)
      (layers "F.Cu" "F.Paste" "F.Mask") (net 0 ""))
  )

  ; Star topology tracks: source (10,30) -> hub (30,30)
  (segment (start 10 30) (end 30 30) (width 0.2) (layer "F.Cu") (net 1))
  ; Hub (30,30) -> U2 (50,15)
  (segment (start 30 30) (end 30 15) (width 0.2) (layer "F.Cu") (net 1))
  (segment (start 30 15) (end 50 15) (width 0.2) (layer "F.Cu") (net 1))
  ; Hub (30,30) -> U3 (50,30)
  (segment (start 30 30) (end 50 30) (width 0.2) (layer "F.Cu") (net 1))
  ; Hub (30,30) -> U4 (50,45)
  (segment (start 30 30) (end 30 45) (width 0.2) (layer "F.Cu") (net 1))
  (segment (start 30 45) (end 50 45) (width 0.2) (layer "F.Cu") (net 1))

  (gr_rect (start 0 0) (end 100 80) (layer "Edge.Cuts") (width 0.1))
)
