(kicad_pcb
  (version 20240108)
  (generator "pcbnew")
  (generator_version "9.0")
  (general
    (thickness 1.6)
    (legacy_teardrops no)
  )
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (44 "Edge.Cuts" user)
  )
  (setup
    (pad_to_mask_clearance 0.1)
    (allow_soldermask_bridges_in_footprints no)
  )
  (net 0 "")
  (net 1 "VCC")
  (net 2 "GND")

  ; Initial board: 85x56mm rectangle, no mounting holes, no rounded corners
  (gr_rect (start 0 0) (end 85 56) (layer "Edge.Cuts") (width 0.1))

  ; 2x20 GPIO header at (30, 10) -- needs to be repositioned
  (footprint "Connector_PinHeader_2.54mm:PinHeader_2x20_P2.54mm_Vertical" (layer "F.Cu") (at 30 10)
    (reference "J1") (value "GPIO_HEADER")
    (pad "1" thru_hole circle (at 0 0) (size 1.7 1.7) (drill 1.0)
      (layers "F.Cu" "B.Cu" "F.Mask" "B.Mask") (net 1 "VCC"))
  )
)
