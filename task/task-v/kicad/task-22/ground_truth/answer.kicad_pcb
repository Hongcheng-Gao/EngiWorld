(kicad_pcb
  (version 20240108)
  (generator "pcbnew")
  (generator_version "9.0")
  (general
    (thickness 1.6)
    (legacy_teardrops no)
  )
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (44 "Edge.Cuts" user)
  )
  (setup
    (pad_to_mask_clearance 0.1)
    (allow_soldermask_bridges_in_footprints no)
  )
  (net 0 "")
  (net 1 "VCC")
  (net 2 "GND")

  ; Shrunk board: 119x78mm to fit Hammond 1455C1201 slot
  (gr_rect (start 0 0) (end 119 78) (layer "Edge.Cuts") (width 0.1))

  ; U1 at (20,20): dist to edges = min(20,99,20,58) = 20mm >= 3mm ✓
  (footprint "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm" (layer "F.Cu") (at 20 20)
    (reference "U1") (value "OPAMP")
    (pad "1" smd rect (at -1.2 -1.27) (size 1.55 0.6)
      (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "VCC"))
  )

  ; R1 moved from (50,1.5) to (50,5): dist to bottom edge = 5mm >= 3mm ✓
  (footprint "Resistor_SMD:R_0603_1608Metric" (layer "F.Cu") (at 50 5)
    (reference "R1") (value "4.7k")
    (pad "1" smd rect (at -0.8 0) (size 1.0 0.8)
      (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "VCC"))
  )

  ; U2 moved from (148,50) to (110,50): dist to right edge (x=119) = 9mm >= 3mm ✓
  (footprint "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm" (layer "F.Cu") (at 110 50)
    (reference "U2") (value "ADC")
    (pad "1" smd rect (at -1.2 -1.27) (size 1.55 0.6)
      (layers "F.Cu" "F.Paste" "F.Mask") (net 2 "GND"))
  )

  ; R2 at (80,60): dist to edges = min(80,39,60,18) = 18mm >= 3mm ✓
  (footprint "Resistor_SMD:R_0603_1608Metric" (layer "F.Cu") (at 80 60)
    (reference "R2") (value "10k")
    (pad "1" smd rect (at -0.8 0) (size 1.0 0.8)
      (layers "F.Cu" "F.Paste" "F.Mask") (net 2 "GND"))
  )
)
