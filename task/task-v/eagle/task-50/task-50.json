          }
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "/opt/eagle-7.7.0/bin/eagle",
          "/home/user/Desktop/vias.brd"
        ]
      }
    }
  ],
  "trajectory": "trajectories/",
