{
  "id": "v-eagle-task-40-ubuntu",
  "snapshot": "eagle-7.7.0",
  "instruction": "Open `/home/user/Desktop/review.sch`, run EAGLE's Electrical Rule Check on it, and export the resulting plain-text ERC report as `/home/user/Desktop/errors.erc`.\n\nRequirements:\n1. `/home/user/Desktop/errors.erc` must exist and be non-empty.\n2. It must be readable as plain text.\n3. It must clearly be an ERC report from EAGLE.\n4. It must contain at least one reported issue from this schematic.\n5. The report should be the actual ERC output for `/home/user/Desktop/review.sch`, not a hand-written summary.",
  "source": "https://www.autodesk.com/products/fusion-360/blog/schematic-basics-part-3-erc/",
  "config": [
    {
      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "task-40/init_file/review.sch",
            "path": "/home/user/Desktop/review.sch"
          }
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "/opt/eagle-7.7.0/bin/eagle",
          "/home/user/Desktop/review.sch"
        ]
      }
    }
  ],
  "trajectory": "trajectories/",
  "related_apps": [
    "eagle"
  ],
  "evaluator": {
    "postconfig": [
      {
        "type": "upload_file",
        "parameters": {
          "files": [
            {
              "local_path": "task-40/eval.py",
              "path": "/home/user/Desktop/eval.py"
            }
          ]
        }
      }
    ],
    "func": "exact_match",
    "result": {
      "type": "vm_command_line",
      "command": "python /home/user/Desktop/eval.py",
      "shell": "true"
    },
    "expected": {
      "type": "rule",
      "rules": {
        "expected": "true\n"
      }
    }
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low"
}
