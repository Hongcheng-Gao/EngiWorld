        <hole x="4" y="21" drill="3.2" />
        <circle x="8" y="12.5" radius="0.75" width="0.12" layer="21" />
        <circle x="20" y="20.5" radius="0.75" width="0.12" layer="21" />
        <circle x="32" y="12.5" radius="0.75" width="0.12" layer="21" />
        <rectangle x1="17" y1="10" x2="23" y2="15" layer="41" />
        <text x="2" y="22.5" size="1.2" layer="21">REV-A</text>
      </plain>
      <libraries>
        <library name="synth">
          <packages>
            <package name="R0805">
              <description>Generic 0805 resistor footprint</description>
              <smd name="1" x="-1.0" y="0" dx="1.0" dy="1.3" layer="1" roundness="0" />
              <smd name="2" x="1.0" y="0" dx="1.0" dy="1.3" layer="1" roundness="0" />
              <wire x1="-1.5" y1="0.7" x2="1.5" y2="0.7" width="0.127" layer="21" />
              <wire x1="1.5" y1="0.7" x2="1.5" y2="-0.7" width="0.127" layer="21" />
              <wire x1="1.5" y1="-0.7" x2="-1.5" y2="-0.7" width="0.127" layer="21" />
              <wire x1="-1.5" y1="-0.7" x2="-1.5" y2="0.7" width="0.127" layer="21" />
              <text x="-1.5" y="1" size="0.8" layer="25">&gt;NAME</text>
