# apply_jlcpcb_2layer.scr
#
# Applies JLCPCB 2-layer 1oz FR-4 standard design rules + grid settings.
#   - mdWireWire, mdWirePad, mdWireVia, mdPadPad, mdPadVia, mdViaVia,
#     mdSmdPad, mdSmdVia, mdSmdSmd, mdViaViaSameLayer : 0.15 mm
#   - msWidth  (minimum trace width)           : 0.15 mm
#   - mdDrill  (minimum drill distance / via)  : 0.30 mm
#   - rlMin*                                    : 0.15 mm
#   - Grid primary 0.1 mm, alt 0.01 mm
#
# The adjacent jlcpcb_2layer.dru sits in the same directory; DRC LOAD
# resolves it via relative path.
SET CONFIRM YES;
GRID MM 0.1 ALT 0.01;
DRC LOAD 'jlcpcb_2layer.dru';
SET CONFIRM OFF;
