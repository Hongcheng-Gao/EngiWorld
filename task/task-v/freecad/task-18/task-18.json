{
  "id": "v-freecad-task-18-ubuntu",
  "snapshot": "FreeCAD0.21.2",
  "instruction": "Look at freecad_task-18_input.step in FreeCAD. Use the Part Design workbench for the modeling operations; activate or create the relevant Body, create new sketches for sketch-based features, and use feature or placement tools for the requested edits. Cut a dovetail slot through the full 80 mm length along X. The slot is centered at Y=20 mm on the top face, has top opening width 26 mm, bottom width 16 mm, and depth 10 mm. Export the dovetail block as /home/user/Desktop/freecad_task-18_output.step.",
  "source": "https://wiki.freecad.org/Import_Export; https://wiki.freecad.org/Part_Workbench; https://wiki.freecad.org/PartDesign_Workbench",
  "config": [
    {
      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "task-18/init_file/freecad_task-18_input.step",
            "path": "/home/user/Desktop/freecad_task-18_input.step"
          }
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "freecad",
          "/home/user/Desktop/freecad_task-18_input.step"
        ]
      }
    }
  ],
  "trajectory": "trajectories/",
