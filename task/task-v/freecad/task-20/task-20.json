{
  "id": "v-freecad-task-20-ubuntu",
  "snapshot": "FreeCAD0.19",
  "instruction": "look at freecad_task-20_input.step in the FreeCAD GUI. Move the upright support to the center of the base plate top face so the support bottom touches the base top, with the support center at (60,30). Fuse the support and base into one solid. Cut one through hole of diameter 10 mm through the support along the Y direction. Export freecad_task-20_output.step.",
  "source": "https://wiki.freecad.org/Import_Export; https://wiki.freecad.org/Part_Workbench; https://wiki.freecad.org/PartDesign_Workbench",
  "config": [
    {
      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "task-20/init_file/freecad_task-20_input.step",
            "path": "/home/user/Desktop/freecad_task-20_input.step"
          }
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "freecad",
          "/home/user/Desktop/freecad_task-20_input.step"
        ]
      }
    }
  ],
  "trajectory": "trajectories/",
  "related_apps": [
    "freecad"
  ],
  "evaluator": {
    "postconfig": [
      {
        "type": "upload_file",
        "parameters": {
          "files": [
            {
              "local_path": "task-20/eval.py",
              "path": "/home/user/Desktop/eval.py"
            }
          ]
        }
      }
    ],
    "func": "exact_match",
    "result": {
      "type": "vm_command_line",
      "command": "python /home/user/Desktop/eval.py",
      "shell": "true"
    },
    "expected": {
      "type": "rule",
      "rules": {
        "expected": "true\n"
      }
    }
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low"
}
