{
  "id": "v-freecad-task-10-ubuntu",
  "snapshot": "FreeCAD0.21.2",
  "instruction": "Look at freecad_task-10_input.step in FreeCAD. In the annular ring, cut a rectangular side notch on the +X side. The notch is 18 mm wide along Y, extends from X=20 mm to X=40 mm, and cuts through the full 8 mm thickness. Preserve the center hole and remaining ring geometry. Export freecad_task-10_output.step.",
  "source": "https://wiki.freecad.org/Import_Export; https://wiki.freecad.org/Part_Workbench; https://wiki.freecad.org/PartDesign_Workbench",
  "config": [
    {
      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "task-10/init_file/freecad_task-10_input.step",
            "path": "/home/user/Desktop/freecad_task-10_input.step"
          }
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "freecad",
          "/home/user/Desktop/freecad_task-10_input.step"
        ]
      }
    }
  ],
  "trajectory": "trajectories/",
  "related_apps": [
    "freecad"
  ],
  "evaluator": {
    "postconfig": [
      {
        "type": "upload_file",
        "parameters": {
          "files": [
            {
              "local_path": "task-10/eval.py",
              "path": "/home/user/Desktop/eval.py"
            }
          ]
        }
      }
    ],
    "func": "exact_match",
    "result": {
      "type": "vm_command_line",
      "command": "python /home/user/Desktop/eval.py",
      "shell": "true"
    },
    "expected": {
      "type": "rule",
      "rules": {
        "expected": "True\n"
      }
    }
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low"
}
