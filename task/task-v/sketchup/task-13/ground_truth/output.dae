<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <created>2026-04-23T20:20:53.139691</created>
    <modified>2026-04-23T20:20:53.139697</modified>
    <up_axis>Y_UP</up_axis>
  </asset>
  <library_effects>
    <effect id="brick-eff" name="brick-eff">
      <profile_COMMON>
        <newparam sid="brick-surface">
          <surface type="2D">
            <init_from>brick-img</init_from>
            <format>A8R8G8B8</format>
          </surface>
        </newparam>
        <newparam sid="brick-sampler">
          <sampler2D>
            <source>brick-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color>0.0 0.0 0.0 1.0</color>
            </emission>
            <ambient>
              <color>0.0 0.0 0.0 1.0</color>
            </ambient>
            <diffuse>
              <texture texture="brick-sampler" texcoord="UVSET0" />
            </diffuse>
            <specular>
              <color>0.0 0.0 0.0 1.0</color>
            </specular>
            <shininess>
              <float>0.0</float>
            </shininess>
            <reflective>
              <color>0.0 0.0 0.0 1.0</color>
            </reflective>
            <reflectivity>
              <float>0.0</float>
            </reflectivity>
            <transparent>
              <color>0.0 0.0 0.0 1.0</color>
            </transparent>
            <transparency>
              <float>1.0</float>
            </transparency>
          </lambert>
        </technique>
        <extra>
          <technique profile="GOOGLEEARTH">
            <double_sided>0</double_sided>
          </technique>
        </extra>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_geometries>
    <geometry id="geom-wall" name="Wall">
      <mesh>
        <source id="wall-pos-array">
          <float_array count="12" id="wall-pos-array-array">0 0 0 5 0 0 5 3 0 0 3 0</float_array>
          <technique_common>
            <accessor count="4" source="#wall-pos-array-array" stride="3">
              <param type="float" name="X" />
              <param type="float" name="Y" />
              <param type="float" name="Z" />
            </accessor>
          </technique_common>
        </source>
        <source id="wall-uv-array">
          <float_array count="8" id="wall-uv-array-array">0 0 20.83333 0 20.83333 42.85714 0 42.85714</float_array>
          <technique_common>
            <accessor count="4" source="#wall-uv-array-array" stride="2">
              <param type="float" name="S" />
              <param type="float" name="T" />
            </accessor>
          </technique_common>
        </source>
        <vertices id="wall-pos-array-vertices">
          <input semantic="POSITION" source="#wall-pos-array" />
        </vertices>
        <triangles count="2" material="matref-brick">
          <input offset="0" semantic="VERTEX" source="#wall-pos-array-vertices" />
          <input offset="1" semantic="TEXCOORD" source="#wall-uv-array" set="0" />
          <p>0 1 2 0 1 2 0 2 3 0 2 3</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_images>
    <image id="brick-img" name="brick-img">
      <init_from>tex/brick.png</init_from>
    </image>
  </library_images>
  <library_materials>
    <material id="brick-mat" name="Brick">
      <instance_effect url="#brick-eff" />
    </material>
  </library_materials>
  <library_visual_scenes>
    <visual_scene id="scene">
      <node id="Wall" name="Wall">
        <instance_geometry url="#geom-wall">
          <bind_material>
            <technique_common>
              <instance_material symbol="matref-brick" target="#brick-mat">
                <bind_vertex_input semantic="UVSET0" input_semantic="TEXCOORD" input_set="0" />
              </instance_material>
            </technique_common>
          </bind_material>
        </instance_geometry>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene>
    <instance_visual_scene url="#scene" />
  </scene>
</COLLADA>
