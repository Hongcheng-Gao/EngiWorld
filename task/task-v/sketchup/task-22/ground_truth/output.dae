    <material id="mat-wood" name="Wood">
      <instance_effect url="#eff-wood" />
    </material>
    <material id="mat-steel" name="Steel">
      <instance_effect url="#eff-steel" />
    </material>
    <material id="mat-rubber" name="Rubber">
      <instance_effect url="#eff-rubber" />
    </material>
  </library_materials>
  <library_visual_scenes>
    <visual_scene id="scene">
      <node id="Board" name="Board">
        <instance_geometry url="#geom-board">
          <bind_material>
            <technique_common>
              <instance_material symbol="matref-Wood" target="#mat-wood" />
            </technique_common>
          </bind_material>
        </instance_geometry>
      </node>
      <node id="Hammer" name="Hammer">
        <instance_geometry url="#geom-hammer-handle">
          <bind_material>
            <technique_common>
              <instance_material symbol="matref-Wood" target="#mat-wood" />
            </technique_common>
          </bind_material>
        </instance_geometry>
        <instance_geometry url="#geom-hammer-head">
          <bind_material>
            <technique_common>
              <instance_material symbol="matref-Steel" target="#mat-steel" />
            </technique_common>
          </bind_material>
        </instance_geometry>
      </node>
      <node id="Screwdriver" name="Screwdriver">
        <instance_geometry url="#geom-sd-handle">
          <bind_material>
            <technique_common>
              <instance_material symbol="matref-Rubber" target="#mat-rubber" />
            </technique_common>
          </bind_material>
        </instance_geometry>
        <instance_geometry url="#geom-sd-shaft">
          <bind_material>
            <technique_common>
              <instance_material symbol="matref-Steel" target="#mat-steel" />
            </technique_common>
          </bind_material>
        </instance_geometry>
      </node>
      <node id="Wrench" name="Wrench">
        <instance_geometry url="#geom-wrench-bar">
          <bind_material>
            <technique_common>
              <instance_material symbol="matref-Steel" target="#mat-steel" />
            </technique_common>
          </bind_material>
        </instance_geometry>
        <instance_geometry url="#geom-wrench-ring">
          <bind_material>
            <technique_common>
              <instance_material symbol="matref-Steel" target="#mat-steel" />
            </technique_common>
          </bind_material>
        </instance_geometry>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene>
    <instance_visual_scene url="#scene" />
  </scene>
</COLLADA>
