<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE eagle SYSTEM "eagle.dtd">
<eagle version="7.7.0">
<drawing>
<settings>
<setting alwaysvectorfont="yes"/>
<setting verticaltext="up"/>
</settings>
<grid distance="0.635" unitdist="mm" unit="mm" style="lines" multiple="1" display="no" altdistance="0.01" altunitdist="inch" altunit="inch"/>
<layers>
<layer number="1" name="Top" color="4" fill="1" visible="yes" active="yes"/>
<layer number="16" name="Bottom" color="1" fill="1" visible="yes" active="yes"/>
<layer number="17" name="Pads" color="2" fill="1" visible="yes" active="yes"/>
<layer number="18" name="Vias" color="2" fill="1" visible="yes" active="yes"/>
<layer number="19" name="Unrouted" color="6" fill="1" visible="yes" active="yes"/>
<layer number="20" name="Dimension" color="15" fill="1" visible="yes" active="yes"/>
<layer number="21" name="tPlace" color="7" fill="1" visible="yes" active="yes"/>
<layer number="22" name="bPlace" color="7" fill="1" visible="yes" active="yes"/>
<layer number="25" name="tNames" color="7" fill="1" visible="yes" active="yes"/>
<layer number="27" name="tValues" color="7" fill="1" visible="no" active="yes"/>
<layer number="29" name="tStop" color="7" fill="3" visible="no" active="yes"/>
<layer number="44" name="Drills" color="7" fill="1" visible="no" active="yes"/>
<layer number="45" name="Holes" color="7" fill="1" visible="no" active="yes"/>
</layers>
<board>
<plain>
<wire x1="0" y1="0" x2="60" y2="0" width="0" layer="20"/>
<wire x1="60" y1="0" x2="60" y2="40" width="0" layer="20"/>
<wire x1="60" y1="40" x2="0" y2="40" width="0" layer="20"/>
<wire x1="0" y1="40" x2="0" y2="0" width="0" layer="20"/>
</plain>
<libraries>
<library name="stub">
<packages>
<package name="DIL8">
<description>DIP-8, 2.54 mm pitch</description>
<pad name="1" x="-3.81" y="-3.81" drill="0.8" diameter="1.6"/>
<pad name="2" x="-1.27" y="-3.81" drill="0.8" diameter="1.6"/>
<pad name="3" x="1.27" y="-3.81" drill="0.8" diameter="1.6"/>
<pad name="4" x="3.81" y="-3.81" drill="0.8" diameter="1.6"/>
<pad name="5" x="3.81" y="3.81" drill="0.8" diameter="1.6"/>
<pad name="6" x="1.27" y="3.81" drill="0.8" diameter="1.6"/>
<pad name="7" x="-1.27" y="3.81" drill="0.8" diameter="1.6"/>
<pad name="8" x="-3.81" y="3.81" drill="0.8" diameter="1.6"/>
<text x="-5.08" y="0" size="1.27" layer="25">&gt;NAME</text>
</package>
<package name="C025">
<description>Radial capacitor, 2.5 mm pitch</description>
<pad name="1" x="-1.27" y="0" drill="0.6" diameter="1.2"/>
<pad name="2" x="1.27" y="0" drill="0.6" diameter="1.2"/>
<text x="-2" y="1.5" size="1.27" layer="25">&gt;NAME</text>
</package>
</packages>
</library>
</libraries>
<attributes/>
<variantdefs/>
<classes>
<class number="0" name="default" width="0" drill="0"/>
</classes>
<designrules/>
<autorouter/>
<elements>
<element name="IC1" library="stub" package="DIL8" value="GENERIC" x="30" y="15" rot="R0"/>
<element name="C3" library="stub" package="C025" value="100n" x="5.0" y="3.0" rot="R0"/>
<element name="C4" library="stub" package="C025" value="100n" x="50.0" y="2.0" rot="R0"/>
<element name="C5" library="stub" package="C025" value="100n" x="8.0" y="30.0" rot="R0"/>
</elements>
<signals>
<signal name="VCC">
<contactref element="IC1" pad="8"/>
<contactref element="C3" pad="2"/>
<contactref element="C4" pad="2"/>
<contactref element="C5" pad="2"/>
</signal>
<signal name="GND">
<contactref element="IC1" pad="4"/>
<contactref element="C3" pad="1"/>
<contactref element="C4" pad="1"/>
<contactref element="C5" pad="1"/>
</signal>
</signals>
</board>
</drawing>
</eagle>
