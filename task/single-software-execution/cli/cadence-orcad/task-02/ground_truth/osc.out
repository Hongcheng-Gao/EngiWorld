
**** 04/27/26 22:49:21 ***** PSpice 25.1.0 (25 March 2026) **** ID# 0 ********

 * Native compensation-selection task.


 ****     CIRCUIT DESCRIPTION


******************************************************************************



* Run the native PSpice transient sweep, keep the generated
* .out/.dat/.measure artifacts, and choose the smallest feedback
* capacitor that keeps overshoot at or below 10%.

.PARAM CASE = 1
.PARAM CFB = {TABLE(CASE, 1,0p, 2,2p, 3,4p, 4,6p, 5,8p)}

VSTEP IN  0   PULSE(0 1 0 50n 50n 200u 400u)
RIN   IN  NEG 2k
RF    OUT NEG 10k
CF    OUT NEG {CFB}
EA    OP  0   LAPLACE {V(0,NEG)} {2e5/((1+s/6.283e4)*(1+s/3.1416e6))}
ROUT  OP  OUT 20
CLOAD OUT 0   470p
RL    OUT 0   1k

.TRAN 50n 350u 0 50n
.STEP PARAM CASE LIST 1 2 3 4 5
.MEAS TRAN CFBVAL PARAM {CFB}
.MEAS TRAN VFINAL FIND V(OUT) AT=150u
.MEAS TRAN VMIN   MIN V(OUT) FROM=0 TO=200u
.PROBE
.END

