(kicad_pcb
  (version 20240108)
  (generator "pcbnew")
  (generator_version "9.0")
  (general
    (thickness 1.6)
    (legacy_teardrops no)
  )
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (44 "Edge.Cuts" user)
  )
  (setup
    (pad_to_mask_clearance 0.1)
    (allow_soldermask_bridges_in_footprints no)
  )
  (net 0 "")
  (net 1 "VCC")
  (net 2 "GND")
  (net 3 "SIG_A")
  (net 4 "SIG_B")
  (net 5 "SIG_C")

  (segment (start 10 10) (end 30 10) (width 0.10) (layer "F.Cu") (net 1))
  (segment (start 30 10) (end 50 10) (width 0.10) (layer "F.Cu") (net 1))
  (segment (start 10 15) (end 30 15) (width 0.10) (layer "F.Cu") (net 2))
  (segment (start 30 15) (end 50 15) (width 0.10) (layer "F.Cu") (net 2))
  (segment (start 10 20) (end 30 20) (width 0.10) (layer "F.Cu") (net 3))
  (segment (start 30 20) (end 50 20) (width 0.10) (layer "F.Cu") (net 3))

  (via (at 55 10) (size 0.45) (drill 0.20) (layers "F.Cu" "B.Cu") (net 1))
  (via (at 55 15) (size 0.45) (drill 0.20) (layers "F.Cu" "B.Cu") (net 2))
  (via (at 55 20) (size 0.45) (drill 0.20) (layers "F.Cu" "B.Cu") (net 3))
  (via (at 55 25) (size 0.45) (drill 0.20) (layers "F.Cu" "B.Cu") (net 4))

  (gr_rect (start 0 0) (end 80 60) (layer "Edge.Cuts") (width 0.1))
)
