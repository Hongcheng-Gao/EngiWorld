(kicad_pcb
  (version 20240108)
  (generator "pcbnew")
  (general (thickness 1.6) (legacy_teardrops no))
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (1 "In1.Cu" power)
    (2 "In2.Cu" power)
    (31 "B.Cu" signal)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (49 "Edge.Cuts" user)
  )
  (setup (pad_to_mask_clearance 0.051))
  (net 0 "")
  (net 1 "GND")
  (zone
    (net 1)
    (net_name "GND")
    (layer "F.Cu")
    (name "GND_TOP")
    (hatch edge 0.508)
    (connect_pads (clearance 0.25))
    (min_thickness 0.25)
    (fill yes (thermal_gap 0.5) (thermal_bridge_width 0.5))
    (polygon (pts (xy 0 0) (xy 80 0) (xy 80 50) (xy 0 50)))
  )
  (zone
    (net 1)
    (net_name "GND")
    (layer "B.Cu")
    (name "GND_BOT")
    (hatch edge 0.508)
    (connect_pads (clearance 0.25))
    (min_thickness 0.25)
    (fill yes (thermal_gap 0.5) (thermal_bridge_width 0.5))
    (polygon (pts (xy 0 0) (xy 80 0) (xy 80 50) (xy 0 50)))
  )
  (gr_rect (start 0 0) (end 80 50) (layer "Edge.Cuts") (width 0.05))
  (gr_rect (start 0 10) (end 6 16) (layer "Edge.Cuts") (width 0.05))
  (gr_rect (start 0 30) (end 6 36) (layer "Edge.Cuts") (width 0.05))
)
