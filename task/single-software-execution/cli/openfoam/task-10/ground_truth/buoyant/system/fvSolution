FoamFile
{
    format ascii;
    class dictionary;
    object fvSolution;
}
solvers
{
    p_rgh
    {
        solver GAMG;
        smoother DICGaussSeidel;
        tolerance 1e-8;
        relTol 0.01;
    }
    "(U|h)"
    {
        solver PBiCGStab;
        preconditioner DILU;
        tolerance 1e-9;
        relTol 0.05;
    }
}
PIMPLE
{
    momentumPredictor no;
    nNonOrthogonalCorrectors 0;
    pRefCell 0;
    pRefValue 0;
}
relaxationFactors
{
    fields { rho 1; p_rgh 0.7; }
    equations { U 0.5; h 0.5; }
}
