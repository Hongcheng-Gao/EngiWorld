{
  "id": "v-open-altium-designer-cadence-orcad-openscad-task-16-windows",
  "snapshot": "OrCAD-Altium-openscad",
  "instruction": "With Altium Designer 17.0.6, open the supplied native `wifi_board.PcbDoc` and create a separate manufacturing panel document. At the start of the task, Altium Designer can be opened from its desktop shortcut; OrCAD Capture is at `C:\\Cadence\\SPB_24.1\\tools\\bin\\Capture.exe`, and OpenSCAD is at `C:\\Program Files\\OpenSCAD\\openscad.exe`. Write the required deliverables into `C:\\Users\\user\\Desktop\\result`. to the Desktop. The panel must contain one Embedded Board Array linked to `wifi_board.PcbDoc`, configured as 4 rows by 3 columns, row spacing 1133.8583 mil, column spacing 1338.5827 mil, mirror enabled, and origin mode 1. Export IPC-2581 Revision B from the panel; Altium Designer 17 names this native XML output `wifi_panel.cvg`, so submit the same unmodified bytes under the required name `wifi_panel.ipc2581`. The two JSON files must summarize the native panel object and IPC-2581 step-repeat values.",
  "source": "https://www.altium.com/documentation/altium-designer/ipc-2581-support?version=17.1; https://files.resources.altium.com/sites/default/files/uberflip_docs/file_1179.pdf; https://www.altium.com/documentation/altium-designer/scripting/running-scripts",
  "config": [
    {
      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "task-16/init_file/panel_spec.json",
            "path": "C:\\Users\\user\\Desktop\\panel_spec.json"
          },
          {
            "local_path": "task-16/init_file/wifi_board.PcbDoc",
            "path": "C:\\Users\\user\\Desktop\\wifi_board.PcbDoc"
          },
          {
            "local_path": "task-16/init_file/wifi_board.ipc2581",
            "path": "C:\\Users\\user\\Desktop\\wifi_board.ipc2581"
          },
          {
            "local_path": "task-16/init_file/wifi_board.pcb.json",
            "path": "C:\\Users\\user\\Desktop\\wifi_board.pcb.json"
          }
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "C:\\Program Files (x86)\\Altium\\AD17\\DXP.EXE",
