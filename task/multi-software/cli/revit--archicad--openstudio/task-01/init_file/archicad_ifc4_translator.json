{
  "archicad_major_version": 27,
  "minimum_build": 6000,
  "schema": "IFC4",
  "model_view": "ReferenceView_V1.2",
  "command_server": {
    "load_method": "Model.LoadFile",
    "validation_method": "Macro.ValidateIfcModel",
    "save_method": "Model.SaveFile"
  },
  "entity_queries": {
    "entity_type": "IfcSpace",
    "selection_method": "Entity.Get",
    "attribute_method": "Entity.GetAttribute",
    "space_attributes": [
      "GlobalId",
      "Name",
      "LongName"
    ]
  },
  "space_boundaries": {
    "policy": "preserve_and_report_upstream_state",
    "generate_missing_relationships": false
  },
  "global_ids": {
    "preserve_all_stage1_ifcroot_ids": true,
    "reject_duplicates": true
  }
}
