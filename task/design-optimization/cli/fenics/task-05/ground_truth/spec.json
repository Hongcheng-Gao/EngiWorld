    "metric_value": 0.0003822634871501113,
    "normalized_observation_rmse_improvement": 0.9984039915868952,
    "native_output": "ground_truth/reference/predictions.json"
  },
  "native_environment": {
    "snapshot": "FEniCS",
    "dolfin": "2019.1.0",
    "python": "3.10.20",
    "verification_mesh": "UnitIntervalMesh(200), CG2"
  }
}
