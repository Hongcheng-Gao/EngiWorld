{
  "id": "opt-fenics-05",
  "title": "FEniCS PDE parameter-inversion observation-error optimization",
  "kind": "parameters",
  "interface": "cli",
  "primary_software": "fenics",
  "objective": "Minimize RMSE between fixed observations and the forward model prediction.",
  "objective_direction": "minimize",
  "metric_name": "observation_rmse",
  "metric_units": "normalized_observation_units",
  "design_file": "parameters.json",
  "result_file": "predictions.json",
  "required_outputs": [
    "parameters.json",
    "solve_submission.py",
    "predictions.json"
  ],
  "parameter_bounds": {
    "E": [
      50000.0,
      250000.0
    ],
    "k": [
      1.0,
      20.0
    ],
    "alpha": [
      0.01,
      0.25
    ]
  },
  "physics": {
    "mechanical_load": 0.8,
    "thermal_load": 1.2
  },
  "forward_model": {
    "elastic_scale": "E / 100000",
    "response": "(mechanical_load / elastic_scale) * x * (1 - x) + (thermal_load / k) * sin(pi * x) + alpha * x^2"
  },
  "fenics_verification_pde": {
    "domain": "0 <= x <= 1",
    "strong_form": "-u''(x) = 2*A + B*pi^2*sin(pi*x) - 2*alpha",
    "coefficients": {
      "A": "mechanical_load / (E / 100000)",
      "B": "thermal_load / k"
    },
    "boundary_conditions": {
      "u(0)": 0.0,
      "u(1)": "alpha"
    },
    "discretization": {
      "mesh_cells": 200,
      "element": "CG2"
    },
    "prediction_rule": "Use the exact response equation at each observation x; the FEniCS solution verifies the equivalent boundary-value problem."
  },
  "observations": [
    {
      "x": 0.15,
      "value": 0.12100390762744567
    },
    {
      "x": 0.3,
      "value": 0.20992902378535888
    },
    {
      "x": 0.45,
      "value": 0.25869975091084596
    },
    {
      "x": 0.6,
      "value": 0.26325194756686726
    },
    {
      "x": 0.75,
      "value": 0.22441885824506286
    },
    {
      "x": 0.9,
      "value": 0.1477494769390637
    }
  ],
  "design_variable": {
    "file": "parameters.json",
    "required_keys": [
      "E",
      "k",
      "alpha"
    ]
  },
  "calibration_status": "calibrated_on_snapshot",
  "baseline": {
    "file": "baseline_parameters.json",
    "artifact": "init_file/baseline_parameters.json",
    "metric_value": 0.2395122005694583,
    "metric_units": "normalized_observation_units",
    "metric_source": "computed_dynamically_by_eval_on_fenics_vm"
  },
  "invalid_sample": {
    "artifact": "ground_truth/invalid/parameters.json"
  },
  "reference": {
