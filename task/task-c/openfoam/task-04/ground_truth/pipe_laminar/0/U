FoamFile
{
    format ascii;
    class volVectorField;
    location "0";
    object U;
}
dimensions [0 1 -1 0 0 0 0];
internalField uniform (1 0 0);
boundaryField
{
    axis { type empty; }
    inlet { type fixedValue; value uniform (1 0 0); }
    outlet { type zeroGradient; }
    wall { type noSlip; }
    wedgeLow { type wedge; }
    wedgeHigh { type wedge; }
}
