<devicesets>
<deviceset name="LM324" prefix="U" uservalue="no">
<description>&lt;b&gt;LM324 Quad Op-Amp&lt;/b&gt; (DIP-14)&lt;p&gt;
Four identical op-amps with a shared V+ / V- supply.
Gate-swappable (swaplevel=1 on every gate).</description>
<gates>
<gate name="A" symbol="OPAMP" x="-15.24" y="10.16" swaplevel="1"/>
