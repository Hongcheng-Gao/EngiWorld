<library>
<description>&lt;b&gt;qfn8&lt;/b&gt;&lt;p&gt;
QFN-8 package authored from scratch for task-30: 5x5 mm body, 0.5 mm pitch,
2 pads per side, pad size 0.25 x 0.6 mm.</description>
<packages>
<package name="QFN-8-0.5">
<description>&lt;b&gt;QFN-8&lt;/b&gt; 5 x 5 mm, 0.5 mm pitch, 2 pads per side.</description>
<wire x1="-2.5" y1="2.5" x2="2.5" y2="2.5" width="0.127" layer="21"/>
<wire x1="2.5" y1="2.5" x2="2.5" y2="-2.5" width="0.127" layer="21"/>
<wire x1="2.5" y1="-2.5" x2="-2.5" y2="-2.5" width="0.127" layer="21"/>
<wire x1="-2.5" y1="-2.5" x2="-2.5" y2="2.5" width="0.127" layer="21"/>
<wire x1="-2.5" y1="2.5" x2="-2.5" y2="2.5" width="0.127" layer="51"/>
<circle x="-2.1" y="2.1" radius="0.15" width="0.1" layer="21"/>
<text x="-2.5" y="2.8" size="0.8128" layer="25">&gt;NAME</text>
<text x="-2.5" y="-3.6" size="0.8128" layer="27">&gt;VALUE</text>
<smd name="1" x="-2.35" y="0.25" dx="0.6" dy="0.25" layer="1"/>
<smd name="2" x="-2.35" y="-0.25" dx="0.6" dy="0.25" layer="1"/>
<smd name="3" x="-0.25" y="-2.35" dx="0.25" dy="0.6" layer="1"/>
<smd name="4" x="0.25" y="-2.35" dx="0.25" dy="0.6" layer="1"/>
<smd name="5" x="2.35" y="-0.25" dx="0.6" dy="0.25" layer="1"/>
<smd name="6" x="2.35" y="0.25" dx="0.6" dy="0.25" layer="1"/>
<smd name="7" x="0.25" y="2.35" dx="0.25" dy="0.6" layer="1"/>
<smd name="8" x="-0.25" y="2.35" dx="0.25" dy="0.6" layer="1"/>
</package>
</packages>
