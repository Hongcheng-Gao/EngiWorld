FoamFile
{
    format ascii;
    class dictionary;
    object fvSolution;
}
solvers
{
    pcorr
    {
        solver PCG;
        preconditioner DIC;
        tolerance 1e-8;
        relTol 0;
    }
    pcorrFinal { $pcorr; relTol 0; }
    p
    {
        solver GAMG;
        smoother DIC;
        tolerance 1e-8;
        relTol 0.05;
    }
    pFinal { $p; relTol 0; }
    U
    {
        solver PBiCGStab;
        preconditioner DILU;
        tolerance 1e-8;
        relTol 0;
    }
}
PIMPLE
{
    momentumPredictor no;
    nOuterCorrectors 2;
    nCorrectors 2;
    nNonOrthogonalCorrectors 0;
}
