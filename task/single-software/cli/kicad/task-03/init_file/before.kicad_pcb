(kicad_pcb
  (version 20240108)
  (generator "pcbnew")
  (generator_version "9.0")
  (general
    (thickness 1.6)
    (legacy_teardrops no)
  )
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (44 "Edge.Cuts" user)
  )
  (setup
    (pad_to_mask_clearance 0)
    (allow_soldermask_bridges_in_footprints no)
  )
  (net 0 "")
  (net 1 "NET_A")
  (net 2 "NET_B")
  (net 3 "NET_C")

  ; Violation 1: NET_A track at y=10.0, NET_B track at y=10.15 -> gap=0.15 < 0.2mm
  (segment (start 10 10.0) (end 40 10.0) (width 0.1) (layer "F.Cu") (net 1))
  (segment (start 10 10.15) (end 40 10.15) (width 0.1) (layer "F.Cu") (net 2))

  ; Violation 2: NET_A track at y=20.0, NET_C track at y=20.15 -> gap=0.15 < 0.2mm
  (segment (start 10 20.0) (end 40 20.0) (width 0.1) (layer "F.Cu") (net 1))
  (segment (start 10 20.15) (end 40 20.15) (width 0.1) (layer "F.Cu") (net 3))

  ; Clean tracks (no violations)
  (segment (start 10 30.0) (end 40 30.0) (width 0.1) (layer "F.Cu") (net 2))
  (segment (start 10 35.0) (end 40 35.0) (width 0.1) (layer "F.Cu") (net 3))

  (gr_rect (start 0 0) (end 80 60) (layer "Edge.Cuts") (width 0.1))
)
