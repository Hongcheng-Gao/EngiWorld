(kicad_pcb (version 20240108) (generator "pcbnew") (generator_version "9.0")
  (general (thickness 1.6) (legacy_teardrops no))
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (44 "Edge.Cuts" user)
  )
  (setup (pad_to_mask_clearance 0.051))
  (net 0 "")
  (net 1 "VCC")
  (net 2 "GND")
  (net 3 "SDA")
  (net 4 "SCL")
  (net 5 "RESET")
  ; R1 at (20,30): pad1=VCC pad2=SDA
  (footprint "Resistor_SMD:R_0402" (layer "F.Cu") (at 20 30)
    (property "Reference" "R1" (at 0 -1.5) (layer "F.SilkS") (uuid "r1-ref"))
    (property "Value" "10k" (at 0 1.5) (layer "F.Fab") (uuid "r1-val"))
    (pad "1" smd roundrect (at -0.55 0) (size 0.7 0.9) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25) (net 1 "VCC") (uuid "r1p1"))
    (pad "2" smd roundrect (at 0.55 0) (size 0.7 0.9) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25) (net 3 "SDA") (uuid "r1p2"))
  )
  ; R2 at (30,30): pad1=SCL pad2=GND
  (footprint "Resistor_SMD:R_0402" (layer "F.Cu") (at 30 30)
    (property "Reference" "R2" (at 0 -1.5) (layer "F.SilkS") (uuid "r2-ref"))
    (property "Value" "4k7" (at 0 1.5) (layer "F.Fab") (uuid "r2-val"))
    (pad "1" smd roundrect (at -0.55 0) (size 0.7 0.9) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25) (net 4 "SCL") (uuid "r2p1"))
    (pad "2" smd roundrect (at 0.55 0) (size 0.7 0.9) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25) (net 2 "GND") (uuid "r2p2"))
  )
  ; C1 at (40,30): pad1=VCC pad2=GND
  (footprint "Capacitor_SMD:C_0402" (layer "F.Cu") (at 40 30)
    (property "Reference" "C1" (at 0 -1.5) (layer "F.SilkS") (uuid "c1-ref"))
    (property "Value" "100nF" (at 0 1.5) (layer "F.Fab") (uuid "c1-val"))
    (pad "1" smd roundrect (at -0.55 0) (size 0.7 0.9) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25) (net 1 "VCC") (uuid "c1p1"))
    (pad "2" smd roundrect (at 0.55 0) (size 0.7 0.9) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25) (net 2 "GND") (uuid "c1p2"))
  )
  ; U1 SOIC-8 at (60,40): pins to VCC,GND,SDA,SCL,RESET
  (footprint "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm" (layer "F.Cu") (at 60 40)
    (property "Reference" "U1" (at 0 -3.5) (layer "F.SilkS") (uuid "u1-ref"))
    (property "Value" "MCU" (at 0 3.5) (layer "F.Fab") (uuid "u1-val"))
    (pad "1" smd rect (at -2.34 -1.905) (size 1.55 0.6) (layers "F.Cu" "F.Paste" "F.Mask") (net 3 "SDA") (uuid "u1p1"))
    (pad "2" smd rect (at -2.34 -0.635) (size 1.55 0.6) (layers "F.Cu" "F.Paste" "F.Mask") (net 4 "SCL") (uuid "u1p2"))
    (pad "3" smd rect (at -2.34 0.635) (size 1.55 0.6) (layers "F.Cu" "F.Paste" "F.Mask") (net 5 "RESET") (uuid "u1p3"))
    (pad "4" smd rect (at -2.34 1.905) (size 1.55 0.6) (layers "F.Cu" "F.Paste" "F.Mask") (net 2 "GND") (uuid "u1p4"))
    (pad "5" smd rect (at 2.34 1.905) (size 1.55 0.6) (layers "F.Cu" "F.Paste" "F.Mask") (net 2 "GND") (uuid "u1p5"))
    (pad "6" smd rect (at 2.34 0.635) (size 1.55 0.6) (layers "F.Cu" "F.Paste" "F.Mask") (net 5 "RESET") (uuid "u1p6"))
    (pad "7" smd rect (at 2.34 -0.635) (size 1.55 0.6) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "VCC") (uuid "u1p7"))
    (pad "8" smd rect (at 2.34 -1.905) (size 1.55 0.6) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "VCC") (uuid "u1p8"))
  )
  ; J1 connector at (80,35): pad1=VCC pad2=GND pad3=SDA pad4=SCL
  (footprint "Connector_PinHeader_2.54mm:PinHeader_1x04_P2.54mm_Vertical" (layer "F.Cu") (at 80 35)
    (property "Reference" "J1" (at 0 -6) (layer "F.SilkS") (uuid "j1-ref"))
    (property "Value" "HDR4" (at 0 6) (layer "F.Fab") (uuid "j1-val"))
    (pad "1" thru_hole circle (at 0 -3.81) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask") (net 1 "VCC") (uuid "j1p1"))
    (pad "2" thru_hole circle (at 0 -1.27) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask") (net 2 "GND") (uuid "j1p2"))
    (pad "3" thru_hole circle (at 0  1.27) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask") (net 3 "SDA") (uuid "j1p3"))
    (pad "4" thru_hole circle (at 0  3.81) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask") (net 4 "SCL") (uuid "j1p4"))
  )
  ; Board outline
  (gr_line (start 10 20) (end 100 20) (layer "Edge.Cuts") (stroke (width 0.05) (type solid)) (uuid "e1"))
  (gr_line (start 100 20) (end 100 60) (layer "Edge.Cuts") (stroke (width 0.05) (type solid)) (uuid "e2"))
  (gr_line (start 100 60) (end 10 60) (layer "Edge.Cuts") (stroke (width 0.05) (type solid)) (uuid "e3"))
  (gr_line (start 10 60) (end 10 20) (layer "Edge.Cuts") (stroke (width 0.05) (type solid)) (uuid "e4"))
)
