      <mesh>
        <source id="geom-broken-pos-array">
          <float_array count="90" id="geom-broken-pos-array-array">0 0 0 1 0 0 0 1 0 1.2 0 0 2.2 0 0 1.2 1 0 2.4 0 0 3.4 0 0 2.4 1 0 3.6 0 0 4.6 0 0 3.6 1 0 4.8 0 0 5.8 0 0 4.8 1 0 0 1.2 0 1 1.2 0 0 2.2 0 1.2 1.2 0 2.2 1.2 0 1.2 2.2 0 2.4 1.2 0 3.4 1.2 0 2.4 2.2 0 3.6 1.2 0 4.6 1.2 0 3.6 2.2 0 4.8 1.2 0 5.8 1.2 0 4.8 2.2 0</float_array>
