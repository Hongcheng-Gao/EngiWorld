  <library_effects>
    <effect id="eff-brick" name="eff-brick">
      <profile_COMMON>
        <newparam sid="surf-brick">
          <surface type="2D">
            <init_from>img-brick</init_from>
            <format>A8R8G8B8</format>
          </surface>
        </newparam>
        <newparam sid="samp-brick">
          <sampler2D>
            <source>surf-brick</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color>0.0 0.0 0.0 1.0</color>
            </emission>
            <ambient>
              <color>0.0 0.0 0.0 1.0</color>
            </ambient>
            <diffuse>
              <texture texture="samp-brick" texcoord="UVSET0" />
            </diffuse>
            <specular>
              <color>0.0 0.0 0.0 1.0</color>
            </specular>
            <shininess>
              <float>0.0</float>
            </shininess>
            <reflective>
              <color>0.0 0.0 0.0 1.0</color>
            </reflective>
            <reflectivity>
              <float>0.0</float>
            </reflectivity>
            <transparent>
              <color>0.0 0.0 0.0 1.0</color>
            </transparent>
            <transparency>
              <float>1.0</float>
            </transparency>
          </lambert>
        </technique>
        <extra>
          <technique profile="GOOGLEEARTH">
            <double_sided>0</double_sided>
          </technique>
        </extra>
      </profile_COMMON>
    </effect>
    <effect id="eff-othermat" name="eff-othermat">
      <profile_COMMON>
        <technique sid="common">
          <lambert>
            <emission>
              <color>0.0 0.0 0.0 1.0</color>
