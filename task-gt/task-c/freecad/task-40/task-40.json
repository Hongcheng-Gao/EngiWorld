{
  "id": "c-freecad-task-40-ubuntu",
  "snapshot": "FreeCAD0.19",
  "instruction": "Using FreeCAD CLI/API, open /home/user/Desktop/freecad_task-40_input.step. Place two support blocks on the base top face, centered at (60,60) and (140,60), and fuse them to the base. Cut one vertical through hole of diameter 12 mm through each support and the base. Cut four corner mounting holes of diameter 6 mm, each 15 mm from adjacent outside edges. Export /home/user/Desktop/freecad_task-40_output.step.",
  "source": "https://wiki.freecad.org/Import_Export; https://wiki.freecad.org/Part_Workbench; https://wiki.freecad.org/Python_scripting_tutorial; https://wiki.freecad.org/Headless_FreeCAD",
  "config": [
    {
      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "task-40/init_file/freecad_task-40_input.step",
            "path": "/home/user/Desktop/freecad_task-40_input.step"
          }
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "freecadcmd",
          "--version"
        ]
      }
    }
  ],
  "trajectory": "trajectories/",
  "related_apps": [
    "freecad"
  ],
  "evaluator": {
    "postconfig": [
      {
        "type": "upload_file",
        "parameters": {
          "files": [
            {
              "local_path": "task-40/eval.py",
              "path": "/home/user/Desktop/eval.py"
            }
          ]
        }
      }
    ],
    "func": "exact_match",
    "result": {
      "type": "vm_command_line",
      "command": "python /home/user/Desktop/eval.py",
      "shell": "true"
    },
    "expected": {
      "type": "rule",
      "rules": {
        "expected": "True\n"
      }
    }
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low"
}
