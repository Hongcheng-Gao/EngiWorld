{
  "id": "c-eagle-task-23-ubuntu",
  "snapshot": "eagle-7.7.0",
  "instruction": "Open `/home/user/Desktop/test.lbr`, run the library consistency check, and save the resulting report as `/home/user/Desktop/consistency.md`.\n\nRequirements:\n1. `/home/user/Desktop/consistency.md` must exist and contain at least 100 bytes of readable UTF-8 text.\n2. The report must mention a missing-pad defect.\n3. The report must mention a duplicate-pin defect.\n4. The report must mention a missing-pin defect.\n5. The report must mention an uncovered-pin or not-connected-pin defect.",
  "source": "https://github.com/plusea/EAGLE/blob/master/ulp/exp-project-lbr.ulp",
  "config": [
    {
      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "task-23/init_file/README.txt",
            "path": "/home/user/Desktop/README.txt"
          }
        ]
      }
    },
    {
      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "task-23/init_file/test.lbr",
            "path": "/home/user/Desktop/test.lbr"
          }
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "bash",
          "-lc",
          "test -x /opt/eagle-7.7.0/bin/eagle && echo OK || echo MISSING"
        ]
      }
    }
  ],
  "trajectory": "trajectories/",
  "related_apps": [
    "eagle"
  ],
  "evaluator": {
    "postconfig": [
      {
        "type": "upload_file",
        "parameters": {
          "files": [
            {
              "local_path": "task-23/eval.py",
              "path": "/home/user/Desktop/eval.py"
            }
          ]
        }
      }
    ],
    "func": "exact_match",
    "result": {
      "type": "vm_command_line",
      "command": "python /home/user/Desktop/eval.py",
      "shell": "true"
    },
    "expected": {
      "type": "rule",
      "rules": {
        "expected": "true\r\n"
      }
    }
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low"
}
