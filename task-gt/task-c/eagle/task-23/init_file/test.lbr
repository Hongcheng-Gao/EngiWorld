<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE eagle SYSTEM "eagle.dtd">
<eagle version="7.7.0">
<drawing>
<settings>
<setting alwaysvectorfont="no"/>
<setting verticaltext="up"/>
</settings>
<grid distance="0.1" unitdist="mm" unit="mm" style="lines" multiple="1" display="yes" altdistance="0.01" altunitdist="mm" altunit="mm"/>
<layers>
<layer number="1" name="Top" color="4" fill="1" visible="yes" active="yes"/>
<layer number="16" name="Bottom" color="1" fill="1" visible="yes" active="yes"/>
<layer number="17" name="Pads" color="2" fill="1" visible="yes" active="yes"/>
<layer number="20" name="Dimension" color="15" fill="1" visible="yes" active="yes"/>
<layer number="21" name="tPlace" color="7" fill="1" visible="yes" active="yes"/>
<layer number="25" name="tNames" color="7" fill="1" visible="yes" active="yes"/>
<layer number="27" name="tValues" color="7" fill="1" visible="yes" active="yes"/>
<layer number="91" name="Nets" color="2" fill="1" visible="yes" active="yes"/>
<layer number="93" name="Pins" color="2" fill="1" visible="yes" active="yes"/>
<layer number="94" name="Symbols" color="4" fill="1" visible="yes" active="yes"/>
<layer number="95" name="Names" color="7" fill="1" visible="yes" active="yes"/>
<layer number="96" name="Values" color="7" fill="1" visible="yes" active="yes"/>
</layers>
<library>
<description>&lt;b&gt;test&lt;/b&gt;&lt;p&gt;
Test library with 4 devicesets; 4 defects are seeded for Consistency Check
to catch. See init_file/README.txt for the defect map.</description>
<packages>
<package name="SOT23-3">
<wire x1="-1.5" y1="0.7" x2="1.5" y2="0.7" width="0.127" layer="21"/>
<wire x1="1.5" y1="0.7" x2="1.5" y2="-0.7" width="0.127" layer="21"/>
<wire x1="1.5" y1="-0.7" x2="-1.5" y2="-0.7" width="0.127" layer="21"/>
<wire x1="-1.5" y1="-0.7" x2="-1.5" y2="0.7" width="0.127" layer="21"/>
<smd name="1" x="-0.95" y="-1.1" dx="1" dy="1.4" layer="1"/>
<smd name="2" x="0.95" y="-1.1" dx="1" dy="1.4" layer="1"/>
<smd name="3" x="0" y="1.1" dx="1" dy="1.4" layer="1"/>
</package>
<package name="DIP-8">
<pad name="1" x="-3.81" y="-3.81" drill="0.8"/>
<pad name="2" x="-1.27" y="-3.81" drill="0.8"/>
<pad name="3" x="1.27" y="-3.81" drill="0.8"/>
<pad name="4" x="3.81" y="-3.81" drill="0.8"/>
<pad name="5" x="3.81" y="3.81" drill="0.8"/>
<pad name="6" x="1.27" y="3.81" drill="0.8"/>
<pad name="7" x="-1.27" y="3.81" drill="0.8"/>
<pad name="8" x="-3.81" y="3.81" drill="0.8"/>
<wire x1="-5" y1="-5" x2="5" y2="-5" width="0.127" layer="21"/>
<wire x1="5" y1="-5" x2="5" y2="5" width="0.127" layer="21"/>
<wire x1="5" y1="5" x2="-5" y2="5" width="0.127" layer="21"/>
<wire x1="-5" y1="5" x2="-5" y2="-5" width="0.127" layer="21"/>
</package>
</packages>
<symbols>
<symbol name="LDO">
<wire x1="-5.08" y1="2.54" x2="5.08" y2="2.54" width="0.254" layer="94"/>
<wire x1="5.08" y1="2.54" x2="5.08" y2="-2.54" width="0.254" layer="94"/>
<wire x1="5.08" y1="-2.54" x2="-5.08" y2="-2.54" width="0.254" layer="94"/>
<wire x1="-5.08" y1="-2.54" x2="-5.08" y2="2.54" width="0.254" layer="94"/>
<pin name="VIN" x="-7.62" y="1.27" visible="pin" length="short" direction="in"/>
<pin name="GND" x="0" y="-5.08" visible="pin" length="short" direction="pwr" rot="R90"/>
<pin name="VOUT" x="7.62" y="1.27" visible="pin" length="short" direction="out" rot="R180"/>
</symbol>
<symbol name="AMP">
<wire x1="-5.08" y1="2.54" x2="5.08" y2="2.54" width="0.254" layer="94"/>
<wire x1="5.08" y1="2.54" x2="5.08" y2="-2.54" width="0.254" layer="94"/>
<wire x1="5.08" y1="-2.54" x2="-5.08" y2="-2.54" width="0.254" layer="94"/>
<wire x1="-5.08" y1="-2.54" x2="-5.08" y2="2.54" width="0.254" layer="94"/>
<pin name="IN" x="-7.62" y="1.27" visible="pin" length="short" direction="in"/>
<pin name="IN" x="-7.62" y="-1.27" visible="pin" length="short" direction="in"/>
<pin name="OUT" x="7.62" y="0" visible="pin" length="short" direction="out" rot="R180"/>
</symbol>
<symbol name="REG">
<wire x1="-5.08" y1="2.54" x2="5.08" y2="2.54" width="0.254" layer="94"/>
<wire x1="5.08" y1="2.54" x2="5.08" y2="-2.54" width="0.254" layer="94"/>
<wire x1="5.08" y1="-2.54" x2="-5.08" y2="-2.54" width="0.254" layer="94"/>
<wire x1="-5.08" y1="-2.54" x2="-5.08" y2="2.54" width="0.254" layer="94"/>
<pin name="VIN" x="-7.62" y="1.27" visible="pin" length="short" direction="in"/>
<pin name="GND" x="0" y="-5.08" visible="pin" length="short" direction="pwr" rot="R90"/>
<pin name="VOUT" x="7.62" y="1.27" visible="pin" length="short" direction="out" rot="R180"/>
</symbol>
<symbol name="BUF">
<wire x1="-5.08" y1="2.54" x2="5.08" y2="2.54" width="0.254" layer="94"/>
<wire x1="5.08" y1="2.54" x2="5.08" y2="-2.54" width="0.254" layer="94"/>
<wire x1="5.08" y1="-2.54" x2="-5.08" y2="-2.54" width="0.254" layer="94"/>
<wire x1="-5.08" y1="-2.54" x2="-5.08" y2="2.54" width="0.254" layer="94"/>
<pin name="IN" x="-7.62" y="0" visible="pin" length="short" direction="in"/>
<pin name="OUT" x="7.62" y="0" visible="pin" length="short" direction="out" rot="R180"/>
<pin name="EN" x="0" y="5.08" visible="pin" length="short" direction="in" rot="R270"/>
</symbol>
</symbols>
<devicesets>
<deviceset name="LDO_OK" prefix="U" uservalue="yes">
<description>Clean deviceset. All pins covered, all pad refs valid.</description>
<gates>
<gate name="G$1" symbol="LDO" x="0" y="0"/>
</gates>
<devices>
<device name="" package="SOT23-3">
<connects>
<connect gate="G$1" pin="VIN" pad="1"/>
<connect gate="G$1" pin="GND" pad="2"/>
<connect gate="G$1" pin="VOUT" pad="3"/>
</connects>
<technologies>
<technology name=""/>
</technologies>
</device>
</devices>
</deviceset>
<deviceset name="REG_BADPAD" prefix="U" uservalue="yes">
<description>Defect: connect references pad 99 which does not exist in SOT23-3.</description>
<gates>
<gate name="G$1" symbol="REG" x="0" y="0"/>
</gates>
<devices>
<device name="" package="SOT23-3">
<connects>
<connect gate="G$1" pin="VIN" pad="1"/>
<connect gate="G$1" pin="GND" pad="2"/>
<connect gate="G$1" pin="VOUT" pad="99"/>
</connects>
<technologies>
<technology name=""/>
</technologies>
</device>
</devices>
</deviceset>
<deviceset name="AMP_DUPPIN" prefix="U" uservalue="yes">
<description>Defect: symbol AMP contains two pins named "IN" (duplicate pin name).</description>
<gates>
<gate name="G$1" symbol="AMP" x="0" y="0"/>
</gates>
<devices>
<device name="" package="DIP-8">
<connects>
<connect gate="G$1" pin="IN" pad="2"/>
<connect gate="G$1" pin="OUT" pad="6"/>
</connects>
<technologies>
<technology name=""/>
</technologies>
</device>
</devices>
</deviceset>
<deviceset name="BUF_UNCOVERED" prefix="U" uservalue="yes">
<description>Defect: symbol BUF has pins IN/OUT/EN but only IN and OUT are in connects; EN is uncovered. Also defect: connect references pin "NOPE" which does not exist in the symbol.</description>
<gates>
<gate name="G$1" symbol="BUF" x="0" y="0"/>
</gates>
<devices>
<device name="" package="DIP-8">
<connects>
<connect gate="G$1" pin="IN" pad="1"/>
<connect gate="G$1" pin="OUT" pad="8"/>
<connect gate="G$1" pin="NOPE" pad="4"/>
</connects>
<technologies>
<technology name=""/>
</technologies>
</device>
</devices>
</deviceset>
</devicesets>
</library>
</drawing>
</eagle>
