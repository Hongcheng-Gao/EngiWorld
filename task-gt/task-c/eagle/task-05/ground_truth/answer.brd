<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE eagle SYSTEM "eagle.dtd">
<eagle version="7.7.0">
<drawing>
<settings>
<setting alwaysvectorfont="yes"/>
<setting verticaltext="up"/>
</settings>
<grid distance="0.5" unitdist="mm" unit="mm" style="lines" multiple="1" display="no" altdistance="0.01" altunitdist="inch" altunit="inch"/>
<layers>
<layer number="1" name="Top" color="4" fill="1" visible="yes" active="yes"/>
<layer number="16" name="Bottom" color="1" fill="1" visible="yes" active="yes"/>
<layer number="17" name="Pads" color="2" fill="1" visible="yes" active="yes"/>
<layer number="18" name="Vias" color="2" fill="1" visible="yes" active="yes"/>
<layer number="19" name="Unrouted" color="6" fill="1" visible="yes" active="yes"/>
<layer number="20" name="Dimension" color="15" fill="1" visible="yes" active="yes"/>
<layer number="21" name="tPlace" color="7" fill="1" visible="yes" active="yes"/>
<layer number="25" name="tNames" color="7" fill="1" visible="yes" active="yes"/>
</layers>
<board>
<plain>
<wire x1="0" y1="0" x2="40" y2="0" width="0" layer="20"/>
<wire x1="40" y1="0" x2="40" y2="20" width="0" layer="20"/>
<wire x1="40" y1="20" x2="0" y2="20" width="0" layer="20"/>
<wire x1="0" y1="20" x2="0" y2="0" width="0" layer="20"/>
</plain>
<libraries>
<library name="stub">
<packages>
<package name="PAD1">
<description>One SMD pad</description>
<smd name="1" x="0" y="0" dx="1.0" dy="0.5" layer="1"/>
<text x="0" y="1" size="0.8" layer="25">&gt;NAME</text>
</package>
</packages>
</library>
</libraries>
<attributes/>
<variantdefs/>
<classes>
<class number="0" name="default" width="0" drill="0"/>
</classes>
<designrules/>
<autorouter/>
<elements>
<element name="P1" library="stub" package="PAD1" value="" x="5" y="5" rot="R0"/>
<element name="P2" library="stub" package="PAD1" value="" x="15" y="5" rot="R0"/>
<element name="P3" library="stub" package="PAD1" value="" x="25" y="5" rot="R0"/>
<element name="P4" library="stub" package="PAD1" value="" x="35" y="5" rot="R0"/>
<element name="P5" library="stub" package="PAD1" value="" x="5" y="15" rot="R0"/>
<element name="P6" library="stub" package="PAD1" value="" x="15" y="15" rot="R0"/>
<element name="P7" library="stub" package="PAD1" value="" x="25" y="15" rot="R0"/>
<element name="P8" library="stub" package="PAD1" value="" x="35" y="15" rot="R0"/>
</elements>
<signals>
<signal name="SIG1">
<contactref element="P1" pad="1"/>
<contactref element="P2" pad="1"/>
<wire x1="5" y1="5" x2="15" y2="5" width="0.2" layer="1"/>
</signal>
<signal name="SIG2">
<contactref element="P3" pad="1"/>
<contactref element="P4" pad="1"/>
<wire x1="25" y1="5" x2="35" y2="5" width="0.2" layer="1"/>
</signal>
<signal name="SIG3">
<contactref element="P5" pad="1"/>
<contactref element="P6" pad="1"/>
<wire x1="5" y1="15" x2="15" y2="15" width="0.2" layer="1"/>
</signal>
<signal name="SIG4">
<contactref element="P7" pad="1"/>
<contactref element="P8" pad="1"/>
<wire x1="25" y1="15" x2="35" y2="15" width="0.2" layer="1"/>
</signal>
</signals>
</board>
</drawing>
</eagle>
