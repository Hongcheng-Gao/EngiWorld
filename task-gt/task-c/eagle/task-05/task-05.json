{
  "id": "c-eagle-task-05-ubuntu",
  "snapshot": "eagle-7.7.0",
  "instruction": "Open `/home/user/Desktop/breakout.brd`, route all 4 signals on the board, and save the result as `/home/user/Desktop/breakout.brd`.\n\nRequirements:\n1. The file must parse as XML.\n2. The set of `<element>` names must remain unchanged.\n3. The set of `<signal>` names must remain unchanged.\n4. Every signal must contain at least one `<wire>` on copper layer `1` or `16`.",
  "source": "https://www.autodesk.com/products/fusion-360/blog/routing-autorouting-pcb-layout-basics-2/",
  "config": [
    {
      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "task-05/init_file/breakout.brd",
            "path": "/home/user/Desktop/breakout.brd"
          }
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "bash",
          "-lc",
          "test -x /opt/eagle-7.7.0/bin/eagle && echo OK || echo MISSING"
        ]
      }
    }
  ],
  "trajectory": "trajectories/",
  "related_apps": [
    "eagle"
  ],
  "evaluator": {
    "postconfig": [
      {
        "type": "upload_file",
        "parameters": {
          "files": [
            {
              "local_path": "task-05/eval.py",
              "path": "/home/user/Desktop/eval.py"
            }
          ]
        }
      }
    ],
    "func": "exact_match",
    "result": {
      "type": "vm_command_line",
      "command": "python /home/user/Desktop/eval.py",
      "shell": "true"
    },
    "expected": {
      "type": "rule",
      "rules": {
        "expected": "true\r\n"
      }
    }
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low"
}
