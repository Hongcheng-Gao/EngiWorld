FoamFile
{
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    left
    {
        type            fixedValue;
        value           uniform (0.5 0 0); // TODO_INLET_FREESTREAM
    }

    right
    {
        type            zeroGradient;
    }

    down
    {
        type            slip;
    }

    up
    {
        type            slip;
    }

    cylinder
    {
        type            movingWallVelocity;
        value           uniform (0 0 0); // TODO_MOVING_WALL_VELOCITY
    }

    defaultFaces
    {
        type            empty;
    }
}

