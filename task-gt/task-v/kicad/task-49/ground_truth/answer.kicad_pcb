(kicad_pcb
  (version 20240108)
  (generator "pcbnew")
  (generator_version "9.0")
  (general
    (thickness 1.6)
    (legacy_teardrops no)
  )
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (44 "Edge.Cuts" user)
  )
  (setup
    (pad_to_mask_clearance 0.1)
    (allow_soldermask_bridges_in_footprints no)
  )
  (net 0 "")
  (net 1 "GND")
  (net 2 "VCC")

  ; H1 at (10,15): Y=15 < analog_midline=50, lowest Y — stays isolated (np_thru_hole)
  (footprint "MountingHole:MountingHole_2.75mm_M2.5" (layer "F.Cu") (at 10 15)
    (reference "H1") (value "MountingHole")
    (attr through_hole)
    (pad "" np_thru_hole circle (at 0 0) (size 2.5 2.5) (drill 2.5)
      (layers "F.Cu" "B.Cu" "F.Mask" "B.Mask"))
  )

  ; H2 at (90,25): converted to plated GND, size=4.5, drill=2.5, annular=(4.5-2.5)/2=1mm
  (footprint "MountingHole:MountingHole_2.75mm_M2.5" (layer "F.Cu") (at 90 25)
    (reference "H2") (value "MountingHole")
    (attr through_hole)
    (pad "1" thru_hole oval (at 0 0) (size 4.5 4.5) (drill 2.5)
      (layers "F.Cu" "B.Cu" "F.Mask" "B.Mask") (net 1 "GND") (thermal_width 0.4))
  )

  ; H3 at (10,75): converted to plated GND
  (footprint "MountingHole:MountingHole_2.75mm_M2.5" (layer "F.Cu") (at 10 75)
    (reference "H3") (value "MountingHole")
    (attr through_hole)
    (pad "1" thru_hole oval (at 0 0) (size 4.5 4.5) (drill 2.5)
      (layers "F.Cu" "B.Cu" "F.Mask" "B.Mask") (net 1 "GND") (thermal_width 0.4))
  )

  ; H4 at (90,80): converted to plated GND
  (footprint "MountingHole:MountingHole_2.75mm_M2.5" (layer "F.Cu") (at 90 80)
    (reference "H4") (value "MountingHole")
    (attr through_hole)
    (pad "1" thru_hole oval (at 0 0) (size 4.5 4.5) (drill 2.5)
      (layers "F.Cu" "B.Cu" "F.Mask" "B.Mask") (net 1 "GND") (thermal_width 0.4))
  )

  (gr_rect (start 0 0) (end 100 100) (layer "Edge.Cuts") (width 0.1))
)
